# Tanpa nilai rahasia. Isi nilai asli di .env lokal / dashboard Railway & Vercel.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
# Proxy lewat Vercel (browser tidak perlu menjangkau Railway): API_PROXY_TARGET=<alamat backend>, NEXT_PUBLIC_API_PROXY=true
API_PROXY_TARGET=
NEXT_PUBLIC_API_PROXY=
NEXT_PUBLIC_USE_FIXTURES=true
CONTACT_EMAIL=
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
TRADE_MODE=dry
PAID_FEATURES_ENABLED=false
PORT=8787

# Worker ingest (opsional; ada nilai bawaan)
WORKER_BOARD_MS=120000
WORKER_CANDLES_MS=600000
WORKER_TRADES_MS=600000
WORKER_RETENTION_MS=3600000
WORKER_GT_INTERVAL_MS=6500
WORKER_TOP_N=10

WORKER_MEMESCOPE_MS=180000

# Supabase (nilai diisi pemilik)
SUPABASE_JWT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
WORKER_AGENTS_MS=60000

# Robinhood Chain: testnet dulu; pindah ke mainnet = ganti CHAIN_ENV (parameter di packages/shared/src/chains.ts)
CHAIN_ENV=testnet
NEXT_PUBLIC_CHAIN_ENV=testnet
# RPC berkunci (mis. Alchemy) untuk produksi; kosong = RPC publik (dibatasi laju)
RPC_URL=
NEXT_PUBLIC_RPC_URL=
# Memescope (launchpad Pons V2): saldo kurva dibaca dari RPC MAINNET (data pasar selalu mainnet, walau RPC_URL testnet). Kosong = RPC publik.
MAINNET_RPC_URL=
# Ambang kelulusan kurva Pons V2 (ETH), perkiraan terverifikasi on-chain (lihat apps/worker/src/sources/pons.ts)
PONS_GRADUATION_ETH=4.2
# Ambang kelulusan kurva Virtuals (VIRTUAL); sumber resmi Virtuals: 42.000
VIRTUALS_GRADUATION=42000
WORKER_LAUNCHPAD_MS=300000
# Smart wallets: dinilai dari trade yang diindeks (jendela jam, maks 48 = retensi trade) tiap WORKER_WALLETS_MS
WORKER_WALLETS_MS=600000
WALLETS_WINDOW_HOURS=48

# Mode trade di UI swap: dry = hanya kuotasi + simulasi (tidak ada transaksi dikirim). Ubah ke live HANYA setelah izin eksplisit pemilik.
NEXT_PUBLIC_TRADE_MODE=dry

# Chat: penyedia LLM. TIDAK ADA bawaan; semua kosong = chat menjawab "tidak tersedia". Pilih satu penyedia sesuai keputusan pemilik.
# Opsi A, kompatibel OpenAI (OpenRouter, Groq, Together, Ollama lokal gratis, dll.): isi LLM_BASE_URL dan LLM_MODEL (LLM_API_KEY bila perlu).
#   Contoh lokal: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1   (Ollama, tanpa kunci)
# Opsi B, Anthropic: isi ANTHROPIC_API_KEY (LLM_MODEL opsional, bawaan claude-haiku-5-5).
# LLM_PROVIDER=anthropic|openai hanya perlu bila ingin memaksa; kosong = ditebak dari variabel yang terisi.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# Pembelian kredit/Pro dengan USDG (token ERC-20 di Robinhood Chain), dari wallet pengguna.
# Mati sampai PAID_FEATURES_ENABLED=true DAN PAYMENT_RECIPIENT terisi. Hanya alamat PUBLIK, bukan private key.
PAID_FEATURES_ENABLED=false
PAYMENT_RECIPIENT=
# Kosong = USDG resmi dari packages/shared/src/chains.ts (hanya mainnet). Testnet: isi alamat tUSDG hasil deploy.
PAYMENT_TOKEN_ADDRESS=
PAYMENT_TOKEN_DECIMALS=6
PAYMENT_CONFIRMATIONS=2
